<Application x:Class="PrintNest.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ui:ThemesDictionary Theme="Light"/><ui:ControlsDictionary/></ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Ink" Color="#182B36"/><SolidColorBrush x:Key="Muted" Color="#6C7B84"/>
      <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
      <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Margin" Value="0,14,0,7"/></Style>
      <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="450"/></Style>
      <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="MinWidth" Value="32"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
